# cloudflare-ddns.sh configuration (IPv4 / A record)
# Copy to cloudflare-ddns.conf, fill in, and restrict access:
#   cp cloudflare-ddns.conf.example cloudflare-ddns.conf && chmod 600 cloudflare-ddns.conf
# This file is sourced by bash, so use shell syntax (no spaces around "=").

##############  CLOUDFLARE CREDENTIALS  ##############
# @auth_email           - The email used to login 'https://dash.cloudflare.com' (required only for "global")
# @auth_method          - Set to "global" for Global API Key or "token" for Scoped API Token
# @auth_key             - Your API Token or Global API Key (required)
# @zone_identifier      - Can be found in the "Overview" tab of your domain (required)
# -------------------------------------------------- #
auth_email=""
auth_method="token"
auth_key=""
zone_identifier=""

#############  DNS RECORD CONFIGURATION  #############
# @record_name          - Which record you want to be synced (required), e.g. "home.example.com"
# @ttl                  - DNS TTL (seconds), can be set between (30 if enterprise) 60 and 86400 seconds, or 1 for Automatic
# @proxy                - Set the proxy to true or false
# -------------------------------------------------- #
record_name=""
ttl=3600
proxy="false"

#############  WEBHOOKS CONFIGURATION  ###############
# Leave a URI empty to disable that notification.
# @sitename             - Title of site "Example Site"
# @slackchannel         - Slack Channel #example
# @slackuri             - URI for Slack WebHook "https://hooks.slack.com/services/xxxxx"
# @discorduri           - URI for Discord WebHook "https://discordapp.com/api/webhooks/xxxxx"
# -------------------------------------------------- #
sitename=""
slackchannel=""
slackuri=""
discorduri=""
