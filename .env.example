# Cloudflare DDNS updater settings. Copy to .env next to compose.yaml and fill in:
#   cp .env.example .env && chmod 600 .env
# Values with spaces need quotes, e.g. SITENAME="My Home".

##############  REQUIRED  ##############
# User and group the container runs as; files in ./logs are owned by them.
# Use the IDs of the user that owns your Docker files, e.g. `id docker`.
PUID=1000
PGID=1000

# Scoped API token with Zone.DNS edit permission
CF_API_TOKEN=
# Zone ID, from the "Overview" tab of your domain in the Cloudflare dashboard
CF_ZONE_ID=

# A record (IPv4) to keep updated, e.g. home.example.com. Leave empty to skip IPv4.
CF_RECORD_NAME=

##############  IPv6 (optional)  ##############
# AAAA record to keep updated. Also uncomment `network_mode: host` in compose.yaml.
#CF_RECORD_NAME_V6=
# Read the address from this host's interfaces instead of an external service
# (for static or EUI-64 addresses); needs network_mode: host.
#STATIC_IPV6_MODE=false
# With STATIC_IPV6_MODE: the address suffix to look for, e.g. "ab12:34cd"
#LAST_NOTABLE_HEXES=ffff:ffff

##############  RECORD OPTIONS (optional)  ##############
# TTL in seconds (60-86400, or 1 for automatic)
#CF_TTL=3600
# Proxy the record through Cloudflare: true or false
#CF_PROXY=false
# Use a Global API Key instead of a token (CF_API_TOKEN then holds the key)
#CF_AUTH_METHOD=global
#CF_AUTH_EMAIL=you@example.com

##############  NOTIFICATIONS (optional)  ##############
# Site name used in messages
#SITENAME="Example Site"
#DISCORD_URI=https://discord.com/api/webhooks/xxxxx
#SLACK_URI=https://hooks.slack.com/services/xxxxx
#SLACK_CHANNEL=#example

##############  CONTAINER (optional, defaults shown)  ##############
# How often to update: 5m, 1h, 1d, or a cron expression such as "*/15 * * * *"
#DDNS_SCHEDULE=5m
# Run an update as soon as the container starts
#RUN_ON_START=true
# Timezone for log timestamps and the schedule, e.g. America/Chicago
#TZ=UTC
# Log file inside the container (./logs on the host); set empty to log to `docker logs`
#LOG_FILE=/logs/ddns.log
# Rotate the log to ddns.log.1 past this many bytes
#LOG_MAX_SIZE=1048576
