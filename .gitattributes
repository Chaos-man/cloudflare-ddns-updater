# Scripts and configs run on Linux; keep LF line endings even on Windows checkouts
*.sh            text eol=lf
*.conf          text eol=lf
*.conf.example  text eol=lf
docker/*        text eol=lf
Dockerfile      text eol=lf
compose.yaml    text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
